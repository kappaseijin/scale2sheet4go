{
  "name": "scale2sheet",
  "version": "0.1.0",
  "description": "Sync morning and evening body measurements from Google Fit or Apple Health XML to Google Sheets.",
  "type": "module",
  "private": true,
  "bin": {
    "scale2sheet": "./dist/scale2sheet"
  },
  "scripts": {
    "build": "npm run build:go",
    "build:go": "CGO_ENABLED=0 GOTOOLCHAIN=local go build -o dist/scale2sheet ./cmd/scale2sheet",
    "build:legacy-ts": "tsc -p tsconfig.json",
    "acceptance:pipeline-shadow": "bash scripts/run-pipeline-shadow-acceptance.sh",
    "acceptance:google-sheets-deadline": "bash scripts/run-google-sheets-deadline-acceptance.sh",
    "acceptance:binary-drift": "bash scripts/run-binary-source-drift-acceptance.sh",
    "acceptance:runtime-safety": "bash scripts/run-runtime-safety-acceptance.sh",
    "acceptance:installer": "bash scripts/run-installer-acceptance.sh",
    "acceptance:binary-smoke": "bash scripts/run-bun-binary-smoke.sh",
    "acceptance:bun-binary-smoke": "bash scripts/run-bun-binary-smoke.sh",
    "preflight:readme": "node scripts/verify-readme-config-keys.mjs",
    "preflight:ac-ledger": "python3 scripts/check-ac-ledger.py && python3 scripts/check-doc-refs.py && node scripts/verify-readme-config-keys.mjs",
    "dev:legacy-ts": "tsx src/index.ts",
    "test": "npm run test:go",
    "test:go": "CGO_ENABLED=0 GOTOOLCHAIN=local go test ./...",
    "typecheck": "GOTOOLCHAIN=local go vet ./...",
    "test:legacy-ts": "vitest run",
    "typecheck:legacy-ts": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.4.1",
    "pino": "^10.3.1",
    "saxes": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/luxon": "^3.7.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
