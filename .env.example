# 標準の設定は ~/.config/scale2sheet/settings.json（初回実行で自動生成）。
# ここの環境変数は settings.json を上書きするオプションです（空欄は未設定扱い）。
# GOOGLE_SHEET_ID と SCALE_EXPORTER_OUTPUT_DIR に組み込み既定値はありません。
# 未設定なら settings.json の sheet-id / scale-exporter-output-dir を使い、
# それも未設定なら起動時に失敗します（Issue #47, #51）。
TIME_ZONE=Asia/Tokyo
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=体温・血圧
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
GOOGLE_FIT_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_FIT_TOKEN_PATH=~/.config/scale2sheet/google-fit-token.json
GOOGLE_FIT_LOOKBACK_DAYS=14
APPLE_HEALTH_EXPORT_XML=
SCALE_EXPORTER_OUTPUT_DIR=
MORNING_CRON=0 7 * * *
EVENING_CRON=0 21 * * *
